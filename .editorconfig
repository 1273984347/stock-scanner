# EditorConfig — 统一编辑器层面的格式约定（2026-11-28）
# 与 .gitattributes 分工：.editorconfig 管"编辑器写文件时用什么格式"，
# .gitattributes 管"git 入库/检出时怎么规范化"（契约基线已强制 eol=lf）。
# 两者对 LF 的约定一致，不冲突。
# 详见 https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python：PEP 8；仓内实际缩进为 4 空格（api.py / factors.py 等实测）
[*.py]
indent_size = 4

# YAML / JSON / 前端：仓内实际缩进为 2 空格
# .github/workflows/*.yml、docs/refactor/contracts/*.json 实测
[*.{yml,yaml,json,js,ts,html,css}]
indent_size = 2

# Markdown：行尾双空格在 Markdown 中是换行语义，不可裁剪
[*.md]
trim_trailing_whitespace = false

# 生成物与第三方目录不参与格式约定
[node_modules/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
