# 本地配置与密钥（iFinD auth_token 走 config.json；证书/私钥一律不入库）
# 前置 / 限定仓库根目录：不误伤 .github/ISSUE_TEMPLATE/config.yml 等子目录同名文件
/config.json
/config.yaml
/config.yml
*.pem
*.key
*.pfx
*.p12

.gstack/
test-results/
playwright-report/
dist/

# Vendor（不应入库）
node_modules/

# 运行时日志（每日 paper trading / TDX 更新 / 跟踪）
logs/

# Skill 自迭代产物（eval-N, run_loop — 不是源代码）
.claude/skills/*/iteration-*/
.claude/skills/*/run_loop/

# Agent 工作区（memory / 运行态，非项目源码）
.workbuddy/

# Data corrections (运行时人工修正日志, 不是源代码)
data_corrections.json

# 跨进程单飞协调产物（W 完整版）：锁/快照含 PID 与运行期数据，不入库
data/shared/

# 覆盖率产物 (CI 每次重跑都会变; 只有基线 docs/refactor/coverage-baseline.json 入库)
.coverage
coverage.json
docs/refactor/coverage-*.json
!docs/refactor/coverage-baseline.json

# 坑表 P-100 隔离探针：运行时生成、finally 删除；残留也不许入库
tests/test_zz_host_isolation_probe.py

# 本地数据仓（ADR-0033）：数据文件不入库，只提交 manifest 记录覆盖
data/store/*
!data/store/manifest.json

# 全市场导出产物（体积大、含运行数据；确需入库时显式 git add -f）
data/exports/

# CI 路径过滤口径（.github/workflows/test.yml 的 paths-ignore）：
#   纯 .md / 根目录 LICENSE 提交不触发 CI —— 与 AGENTS.md §7.1 的 [skip ci] 纪律同向，机制化替代；
#   docs/refactor/*.json 门禁判据基线**不**忽略 —— 基线更新必须触发 CI 验证，否则漂移不可见。
#   实测：零文件变更的空提交在路径过滤下同样不触发 CI（空提交 1adcc51 未产生任何运行），
#   故「用空提交触发一次 CI」这种验证手段在启用 paths-ignore 后不可用。

# 本地备份目录（bundle + store 快照，约 218MB，不入库）
backups/
